{
  // =========================================================================
  // PREDICTIVE SEMANTIC CACHE INVALIDATION - RUNTIME SETTINGS
  // =========================================================================
  // This file configures the options for run_experiment.py.
  // Run the pipeline using: ./venv/Scripts/python.exe run_experiment.py --config settings.json
  // =========================================================================

  // URL or absolute local folder path of the git repository to analyze
  "repo_url": "https://github.com/psf/black.git",

  // Hugging Face embedding model name. E.g.:
  // - "sentence-transformers/all-MiniLM-L6-v2" (default, lightweight)
  // - "microsoft/codebert-base" (Microsoft CodeBERT)
  // - "microsoft/unixcoder-base" (Microsoft UniXcoder)
  // - "jinaai/jina-embeddings-v2-base-code" (Jina Code 8k context model)
  "model_name": "microsoft/unixcoder-base",

  // Parser mode:
  // - "ast": local Python parser only (no Joern server required)
  // - "joern_hybrid": uses Joern CPG + local AST fallbacks (requires Joern server)
  // - "joern_only": uses pure Joern parser and Graph database (requires Joern server)
  "parser_mode": "joern_only",

  // Total number of commit snapshots to extract and analyze
  "num_commits": 100,

  // Stride (step size) between sampled commits in history
  "commit_stride": 10,

  // Ratio of commits to use for training the machine learning model (rest for testing)
  "train_ratio": 0.7,

  // Drift distance limit (cosine distance) above which a node is marked "stale"
  "threshold": 0.02,

  // Threshold mode:
  // - "fixed": use the static threshold value directly
  // - "dynamic": compute threshold dynamically from percentile of drifts
  "threshold_mode": "dynamic",

  // If true, strips all comments and docstrings from methods before embedding
  "clean_mode": false,

  // If true, appends caller/callee function stubs to the code source as context
  "context_chunking": false
}
