{
  "repo_url": "https://github.com/psf/black",
  "model_name": "sentence-transformers/all-MiniLM-L6-v2",
  "parser_mode": "ast",
  "num_commits": 50,
  "commit_stride": 10,
  "train_ratio": 0.7,
  "threshold": 0.05,
  "threshold_mode": "fixed",
  "clean_mode": false,
  "context_chunking": true,
  "device": "auto",
  "label_source": "embedded_text_changed",
  "max_queries_per_entity": 10,
  "ground_truth_queries_path": "src/benchmarking/data/curated_queries_black_change_focused.json",
  "ground_truth_rule": "any_displacement",
  "ground_truth_min_queries": 1,
  "target_recall": 0.99
}